[ "$(basename "$QPATH")" = "$TASK_ID.json" ] || fail "queue filename/task_id mismatch"
PROC="$PROCESSING/$TASK_ID.json"; [ ! -e "$PROC" ] || fail "processing already exists"
mv "$QPATH" "$PROC"; cp "$PROC" "$RUN/task.json"
[ ! -e "$REPO/vos/STOP" ] || fail "vos/STOP present"
REMOTE="$(git -C "$REPO" remote get-url origin)"
case "$REMOTE" in https://github.com/lukeeterna/fluxion-desktop|https://github.com/lukeeterna/fluxion-desktop.git|git@github.com:lukeeterna/fluxion-desktop.git) ;; *) fail "origin mismatch" ;; esac
