    if o.get('type')=='system' and o.get('subtype')=='init': model=str(o.get('model') or ''); session=str(o.get('session_id') or o.get('sessionId') or '')
    if o.get('type')=='assistant':
        for part in (o.get('message') or {}).get('content') or []:
            if isinstance(part,dict) and part.get('type')=='tool_use':tools.append(str(part.get('name') or ''))
    if o.get('type')=='result':final=str(o.get('result') or '')
open(finalp,'w',encoding='utf-8').write(final.strip()+'\n')
if tools:raise SystemExit('verifier tool use observed: '+','.join(tools))
if not session or session==writer:raise SystemExit('verifier session not fresh')
if 'sonnet' not in model.lower():raise SystemExit('verifier model not Sonnet')
try:r=json.loads(final.strip())
except Exception as e:raise SystemExit(f'verifier final is not JSON: {e}')
required={'verdict','safe_to_publish','findings','required_changes','summary'}
