sha256() { shasum -a 256 "$1" | awk '{print $1}'; }

json_get() {
  python3 - "$1" "$2" <<'PY'
import json,sys
d=json.load(open(sys.argv[1],encoding='utf-8'))
v=d.get(sys.argv[2])
if v is None: raise SystemExit(2)
if isinstance(v,(dict,list)): print(json.dumps(v,ensure_ascii=False,separators=(',',':')))
else: print(v)
PY
}

resolve_claude_runtime() {
  python3 - "$CLAUDE_PIN" "$EXPECTED_CLAUDE_VERSION" <<'PY'
import hashlib,json,os,re,subprocess,sys
p,version=sys.argv[1:]
try:
    d=json.load(open(p,encoding='utf-8'))
    assert d.get('schema_version')==1 and d.get('version')==version
    expected=str(d.get('sha256') or ''); assert re.fullmatch(r'[0-9a-f]{64}',expected)
    path=str(d.get('path') or '')
    assert os.path.isabs(path) and os.path.realpath(path)==path and os.access(path,os.X_OK)
    h=hashlib.sha256()
    with open(path,'rb') as f:
        for chunk in iter(lambda:f.read(1024*1024),b''): h.update(chunk)
    assert h.hexdigest()==expected
    v=subprocess.run([path,'--version'],text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,check=False)
    assert v.returncode==0 and v.stdout.strip().startswith(version)
    cs=subprocess.run(['/usr/bin/codesign','--verify','--verbose=2',path],stdout=subprocess.PIPE,stderr=subprocess.PIPE,check=False)
    assert cs.returncode==0
except Exception:
    raise SystemExit(2)
print(path)
PY
}

ensure_evidence_files() {
  touch "$RUN/task.json" "$RUN/task.txt" "$RUN/writer.stream.jsonl" "$RUN/writer.stderr" \
    "$RUN/writer.final.txt" "$RUN/writer.rc" "$RUN/writer.model.txt" "$RUN/writer.tools.txt" \
    "$RUN/writer-result.json" "$RUN/changed_paths.txt" "$RUN/staged-paths.txt" \
    "$RUN/diff-check.stdout" "$RUN/diff-check.stderr" "$RUN/commit.stdout" "$RUN/commit.stderr" \
    "$RUN/dossier.json" "$RUN/dossier.sha256" "$RUN/verifier.prompt.txt" \
    "$RUN/verifier.stream.jsonl" "$RUN/verifier.stderr" "$RUN/verifier.final.txt" "$RUN/verifier.rc" \
    "$RUN/verifier-result.json" "$RUN/evidence.json" "$RUN/publish.stdout" "$RUN/publish.stderr" \
    "$RUN/align.stdout" "$RUN/align.stderr" "$RUN/validation.txt" "$RUN/branch.txt" "$RUN/worktree.txt"
}

cleanup_worktree() {
  [ -n "$WT" ] || return 0
  case "$WT" in "$WTROOT/"*) ;; *) return 2 ;; esac
  if [ -e "$WT" ]; then git -C "$REPO" worktree remove --force "$WT" >/dev/null 2>&1 || return 2; fi
  if [ -n "$BRANCH" ]; then git -C "$REPO" branch -D "$BRANCH" >/dev/null 2>&1 || true; fi
}

cleanup_retention() {
  python3 - "$RUNROOT" "$PACKET_ARCHIVE" "$RUN_RETENTION_DAYS" "$PACKET_RETENTION_DAYS" "${RUN:-}" <<'PY'
import shutil,sys,time
from pathlib import Path
runroot=Path(sys.argv[1]).resolve(); packetroot=Path(sys.argv[2]).resolve()
run_days=int(sys.argv[3]); packet_days=int(sys.argv[4]); current=Path(sys.argv[5]).resolve() if sys.argv[5] else None
now=time.time()
def old(p,d):
    try:return now-p.stat().st_mtime>d*86400
    except FileNotFoundError:return False
if runroot.is_dir():
    for p in runroot.iterdir():
        if p.is_dir() and not (current and p.resolve()==current) and old(p,run_days): shutil.rmtree(p)
if packetroot.is_dir():
    for d in packetroot.iterdir():
        if not d.is_dir(): continue
        for p in d.iterdir():
            if p.is_file() and old(p,packet_days): p.unlink()
        try:d.rmdir()
        except OSError:pass
PY
}

make_result() {
  local verdict="ROSSO" next_event="SOL_ORCHESTRATOR_TRIAGE"
  [ "$STATUS" = "PASS" ] && { verdict="VERDE"; next_event="SOL_ORCHESTRATOR_CONTINUE"; }
  python3 - "$RUN/result.json" "$TASK_ID" "$BASE" "${RESULT_COMMIT:-$BASE}" "$STATUS" "$PROFILE" "$REASON" "$CHANNEL" "$verdict" "$next_event" "$WRITER_SESSION" "$VERIFIER_SESSION" <<'PY'
import datetime,json,sys
p,task,base,result,status,profile,reason,channel,verdict,next_event,writer,verifier=sys.argv[1:]
d={"schema_version":1,"channel":channel,"kind":"RESULT","session_id":"TRUSTED-LOCAL-GENERIC-WRITE",
   "task_id":task,"created_at":datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat().replace('+00:00','Z'),
   "base_commit":base,"result_commit":result,"status":status,"packet_name":f"result-{task}.zip","packet_sha256":"PENDING",
   "summary":f"executor=trusted-local-generic-write;profile={profile};verdict=VERDETTO: {verdict};fresh_verifier={'yes' if verifier else 'no'};cas_publish={'yes' if status=='PASS' else 'no'};next_event={next_event}"}
if writer:d['writer_session_id']=writer
if verifier:d['verifier_session_id']=verifier
if status!='PASS':d['reason']=reason[:500]
open(p,'w',encoding='utf-8').write(json.dumps(d,ensure_ascii=False,indent=2,sort_keys=True)+'\n')
PY
}

packetize_and_publish() {
  local packet="$RUN/result-$TASK_ID.zip"
  (
    cd "$RUN"
    zip -q "$packet" task.json task.txt writer.stream.jsonl writer.stderr writer.final.txt writer.rc \
      writer.model.txt writer.tools.txt writer-result.json changed_paths.txt staged-paths.txt \
      diff-check.stdout diff-check.stderr commit.stdout commit.stderr dossier.json dossier.sha256 \
      verifier.prompt.txt verifier.stream.jsonl verifier.stderr verifier.final.txt verifier.rc \
      verifier-result.json evidence.json publish.stdout publish.stderr align.stdout align.stderr \
      validation.txt branch.txt worktree.txt
  )
  local psha="$(sha256 "$packet")"
  python3 - "$RUN/result.json" "$psha" <<'PY'
import json,sys
p,sha=sys.argv[1:]; d=json.load(open(p,encoding='utf-8')); d['packet_sha256']=sha
open(p,'w',encoding='utf-8').write(json.dumps(d,ensure_ascii=False,indent=2,sort_keys=True)+'\n')
PY
  local cadir="$PACKET_ARCHIVE/$TASK_ID"; mkdir -p "$cadir"; chmod 700 "$cadir"
  install -m 600 "$packet" "$cadir/$psha.zip"
  install -m 600 "$RUN/result.json" "$cadir/$psha.result.json"
  "$DRAFT" create-result-draft "$RUN/result.json" "$packet" >"$RUN/draftbus.stdout" 2>"$RUN/draftbus.stderr"
}

fail() {
  REASON="$1"; STATUS="${2:-BLOCKED}"
  [ -n "$RUN" ] || RUN="$RUNROOT/unknown-$STAMP"; mkdir -p "$RUN"; ensure_evidence_files
  [ -n "$TASK_ID" ] || TASK_ID="$(basename "$QPATH" .json)"
  [ -n "$BASE" ] || BASE="0000000000000000000000000000000000000000"
  [ -n "$RESULT_COMMIT" ] || RESULT_COMMIT="$BASE"
  printf 'BLOCKED: %s\nVERDETTO: ROSSO\n' "$REASON" > "$RUN/writer.final.txt"
  [ -s "$RUN/writer.rc" ] || echo 2 > "$RUN/writer.rc"
  [ -f "$RUN/task.json" ] || cp "$QPATH" "$RUN/task.json" 2>/dev/null || true
  printf 'status=%s\nreason=%s\n' "$STATUS" "$REASON" > "$RUN/validation.txt"
  make_result
  [ -x "$DRAFT" ] && packetize_and_publish || true
  if [ -n "$PROC" ] && [ -f "$PROC" ] && [ ! -e "$FAILED/$(basename "$PROC")" ]; then mv "$PROC" "$FAILED/" || true; fi
  cleanup_worktree || true; cleanup_retention || true
  echo "GENERIC_WRITE_BLOCKED=$REASON"
  exit 2
}

CLAUDE="$(resolve_claude_runtime)" || { echo "BLOCKED: claude runtime pin invalid"; exit 2; }
