t=json.load(open(sys.argv[1],encoding='utf-8')); allowed=set(t['allowed_paths']); changed={x.strip() for x in open(sys.argv[2]) if x.strip()}
assert changed and changed<=allowed
PY
while IFS= read -r p; do [ -n "$p" ] && git -C "$WT" add -- "$p"; done < "$RUN/changed_paths.txt"
git -C "$WT" diff --cached --name-only | sort > "$RUN/staged-paths.txt"; cmp -s "$RUN/changed_paths.txt" "$RUN/staged-paths.txt" || fail "staged paths mismatch"
