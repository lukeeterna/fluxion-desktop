CANON_HEAD_BEFORE="$(git -C "$REPO" rev-parse HEAD)"; CANON_STATUS_BEFORE="$(git -C "$REPO" status --porcelain)"
[ "$CANON_HEAD_BEFORE" = "$BASE" ] || fail "canonical HEAD mismatch"
git -C "$REPO" fetch --no-tags origin 'refs/heads/master:refs/remotes/origin/master' || fail "trusted fetch failed"
[ "$(git -C "$REPO" rev-parse refs/remotes/origin/master)" = "$BASE" ] || fail "origin/master mismatch"
python3 - "$PROC" <<'PY' || fail "dirty allowed-path overlap"
import json,subprocess,sys
t=json.load(open(sys.argv[1],encoding='utf-8')); allowed=set(t['allowed_paths'])
raw=subprocess.check_output(['git','-C','/Volumes/MontereyT7/FLUXION','status','--porcelain'],text=True)
for line in raw.splitlines():
    p=line[3:]
    if ' -> ' in p:p=p.split(' -> ',1)[1]
    if p in allowed: raise SystemExit(f'dirty allowed path: {p}')
PY

BRANCH="vos/auto-$SLUG-$STAMP"; WT="$WTROOT/$SLUG-$STAMP"
echo "$BRANCH" > "$RUN/branch.txt"; echo "$WT" > "$RUN/worktree.txt"
git -C "$REPO" worktree add -b "$BRANCH" "$WT" "$BASE" >/dev/null 2>&1 || fail "git worktree add failed"
SYSTEM="$WT/docs/judge/HEADLESS-CC-EXECUTOR-SYSTEM.md"; [ -f "$SYSTEM" ] || fail "HEADLESS system prompt absent"
python3 - "$PROC" "$BRANCH" "$WT" > "$RUN/task.txt" <<'PY'
import json,sys
p,branch,wt=sys.argv[1:]; t=json.load(open(p,encoding='utf-8'))
print(f'''Execute exactly the sealed FLUXION TASK JSON below.
ROLE: Claude Code LOCAL writer only; model Sonnet. GPT-5.6 Sol owns architecture.
WORKTREE: {wt}
BRANCH: {branch}
RULES: modify ONLY task.allowed_paths. Use only Read/Edit/Write. Bash, Git, process launch, network, Web, Agent, MCP and publisher are unavailable. Do not run tests or commits. Finish with exactly VERDETTO: VERDE if edits are complete, otherwise VERDETTO: ROSSO.
SEALED TASK JSON:\n{json.dumps(t,ensure_ascii=False,indent=2,sort_keys=True)}''')
PY
SETTINGS="$(python3 - "$WT" <<'PY'
import json,sys
wt=sys.argv[1].rstrip('/')
def rule(tool,suffix):return f"{tool}(//{wt.lstrip('/')}/{suffix})"
allow=[rule(t,'**') for t in ('Read','Edit','Write')]; deny=[]
for t in ('Read','Edit','Write'):deny += [rule(t,'.git'),rule(t,'.git/**')]
print(json.dumps({'autoMemoryEnabled':False,'permissions':{'allow':allow,'deny':deny}},separators=(',',':')))
PY
)"

cd "$WT"; export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=/dev/null
set +e
"$CLAUDE" -p --setting-sources '' --settings "$SETTINGS" --strict-mcp-config --mcp-config '{"mcpServers":{}}' \
  --model sonnet --system-prompt-file "$SYSTEM" --permission-mode dontAsk --tools Read,Edit,Write \
  --disallowedTools Bash,Grep,Glob,NotebookEdit,Agent,WebFetch,WebSearch --disable-slash-commands \
  --no-session-persistence --max-turns 120 --output-format stream-json --verbose "$(cat "$RUN/task.txt")" \
  >"$RUN/writer.stream.jsonl" 2>"$RUN/writer.stderr"
WRC=$?; set -e; echo "$WRC" > "$RUN/writer.rc"
python3 - "$RUN/writer.stream.jsonl" "$RUN/writer.final.txt" "$RUN/writer.model.txt" "$RUN/writer.tools.txt" "$RUN/writer.session.txt" <<'PY' || fail "writer stream invalid"
import json,sys
stream,finalp,modelp,toolp,sessionp=sys.argv[1:]; final=''; model=''; session=''; used=[]
for line in open(stream,encoding='utf-8',errors='replace'):
    try:o=json.loads(line)
    except Exception:continue
    if o.get('type')=='system' and o.get('subtype')=='init':
        model=str(o.get('model') or ''); session=str(o.get('session_id') or o.get('sessionId') or '')
    if o.get('type')=='assistant':
        for part in (o.get('message') or {}).get('content') or []:
            if isinstance(part,dict) and part.get('type')=='tool_use': used.append(str(part.get('name') or ''))
    if o.get('type')=='result':final=str(o.get('result') or '')
open(finalp,'w',encoding='utf-8').write(final.strip()+'\n'); open(modelp,'w').write(model+'\n'); open(toolp,'w').write('\n'.join(used)+('\n' if used else '')); open(sessionp,'w').write(session+'\n')
bad=sorted(set(used)-{'Read','Edit','Write'})
if bad:raise SystemExit('forbidden tool use: '+','.join(bad))
if not session:raise SystemExit('writer session missing')
PY
[ "$WRC" -eq 0 ] || fail "writer Claude rc=$WRC"
grep -qx 'VERDETTO: VERDE' "$RUN/writer.final.txt" || fail "writer verdict not VERDE" "FAIL"
grep -qi 'sonnet' "$RUN/writer.model.txt" || fail "writer model not Sonnet"
WRITER_SESSION="$(cat "$RUN/writer.session.txt")"
[ "$(git -C "$WT" branch --show-current)" = "$BRANCH" ] || fail "worktree branch mismatch"
git -C "$WT" diff --cached --quiet || fail "writer staged changes"

python3 - "$WT" "$RUN/changed_paths.txt" <<'PY' || fail "unsafe changed path shape"
import subprocess,sys
wt,out=sys.argv[1:]; raw=subprocess.check_output(['git','-C',wt,'status','--porcelain'],text=True); paths=set()
for line in raw.splitlines():
    if not line:continue
    status=line[:2]; p=line[3:]
    if ' -> ' in p or 'R' in status or 'C' in status:raise SystemExit('renames/copies unsupported')
    if not p or '\n' in p or '\r' in p:raise SystemExit('unsafe path')
    paths.add(p)
open(out,'w',encoding='utf-8').write(''.join(x+'\n' for x in sorted(paths)))
PY
[ -s "$RUN/changed_paths.txt" ] || fail "empty working diff"
python3 - "$PROC" "$RUN/changed_paths.txt" <<'PY' || fail "diff outside allowed_paths"
