sealed=open(sys.argv[1],encoding='utf-8').read()
print('''You are the independent FLUXION verifier. You are fresh and distinct from the writer. The trusted non-LLM executor has supplied exactly one sealed dossier below. Do not request or use tools, repository access, GitHub, network, files outside this dossier, credentials, Gmail, Bash, Git, MCP or agents. Judge only whether the candidate safely and exactly implements the sealed task boundary evidenced by the dossier. Return EXACTLY one JSON object and no markdown with keys: verdict (GREEN|RED|BLOCKED), safe_to_publish (yes|no), findings (array of strings), required_changes (array of strings), summary (string). GREEN requires no material finding and safe_to_publish=yes.\n\nSEALED DOSSIER:\n'''+sealed)
PY
cd "$RUN"
set +e
"$CLAUDE" -p --setting-sources '' --settings '{"autoMemoryEnabled":false}' --strict-mcp-config --mcp-config '{"mcpServers":{}}' \
  --model sonnet --permission-mode dontAsk --tools "" --disable-slash-commands --no-session-persistence --max-turns 20 \
  --output-format stream-json --verbose "$(cat "$RUN/verifier.prompt.txt")" >"$RUN/verifier.stream.jsonl" 2>"$RUN/verifier.stderr"
VRC=$?; set -e; echo "$VRC" > "$RUN/verifier.rc"
python3 - "$RUN/verifier.stream.jsonl" "$RUN/verifier.final.txt" "$RUN/verifier-result.json" "$TASK_ID" "$CANDIDATE" "$WRITER_SESSION" "$DOSSIER_SHA" <<'PY' || fail "verifier stream/result invalid"
import json,os,sys
stream,finalp,resultp,task,candidate,writer,dsha=sys.argv[1:]; final=''; model=''; session=''; tools=[]
for line in open(stream,encoding='utf-8',errors='replace'):
    try:o=json.loads(line)
