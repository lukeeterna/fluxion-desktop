changed=subprocess.check_output(['git','-C',wt,'diff','--name-only',base,candidate],text=True).splitlines()
d={'schema_version':1,'kind':'SEALED_VERIFIER_DOSSIER','task_id':t['task_id'],'expected_base_sha':base,'candidate_sha':candidate,'merge_base_sha':merge,'allowed_paths':sorted(t['allowed_paths']),'changed_paths':sorted(changed),'diff':diff,'static_results':{'DIFF_CHECK':'PASS','EXPECTED_BASE_ENFORCED':'PASS','CANDIDATE_EXACT_PARENT':'PASS','ALLOWED_PATHS_ENFORCED':'PASS','WRITER_CAPABILITY_BOUNDARY':'PASS','WRITER_CAN_LAUNCH_VERIFIER':'NO'},'writer_result_sha256':wsha,'writer_session_id':w['session_id']}
raw=(json.dumps(d,ensure_ascii=False,sort_keys=True,separators=(',',':'))+'\n').encode(); open(out,'wb').write(raw); os.chmod(out,0o600)
PY
DOSSIER_SHA="$(sha256 "$RUN/dossier.json")"; echo "$DOSSIER_SHA" > "$RUN/dossier.sha256"

python3 - "$RUN/dossier.json" > "$RUN/verifier.prompt.txt" <<'PY'
