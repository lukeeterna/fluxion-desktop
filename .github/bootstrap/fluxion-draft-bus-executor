#!/usr/bin/env python3
import json, os
from pathlib import Path

home=Path.home()
root=home/".local/share/fluxion-draft-bus"
queue=root/"queue"
generic=home/".local/bin/fluxion-generic-write-executor"
ro=home/".local/bin/fluxion-draft-bus-executor-ro-core"
WRITE={"FIX_SCOPED_BUG","APPLY_EXISTING_UNIT"}

rows=[]
if queue.exists():
    for p in queue.glob("*.json"):
        try:
            d=json.loads(p.read_text(encoding="utf-8"))
            rows.append((str(d.get("created_at") or ""),p.name,p,d))
        except Exception:
            rows.append(("",p.name,p,None))
if rows:
    rows.sort(key=lambda x:(x[0],x[1]))
    _,_,p,d=rows[0]
    if isinstance(d,dict) and d.get("action_profile") in WRITE:
        os.execv("/bin/zsh",["/bin/zsh",str(generic),str(p)])
os.execv("/usr/bin/python3",["/usr/bin/python3",str(ro)])
