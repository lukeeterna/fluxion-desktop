#!/bin/zsh
set -euo pipefail

# FLUXION trusted non-LLM publish gate.
# Credentials are supplied by the trusted runtime's Git transport; this script
# never reads, prints, persists, or passes credentials to Claude/verifier.

usage() {
  echo "usage: $0 <repo> <expected-base-sha> <candidate-sha> <task-id> <allowed-paths-file> <writer-result> <writer-result-sha256> <verifier-result> <verifier-result-sha256> <evidence-packet> <evidence-sha256> <approved-state-file>" >&2
  exit 2
}

[ "$#" -eq 12 ] || usage
REPO="$1"
EXPECTED_BASE_SHA="$2"
CANDIDATE_SHA="$3"
TASK_ID="$4"
ALLOWED_PATHS_FILE="$5"
WRITER_RESULT="$6"
WRITER_RESULT_SHA="$7"
VERIFIER_RESULT="$8"
VERIFIER_RESULT_SHA="$9"
EVIDENCE_PACKET="${10}"
EVIDENCE_SHA256="${11}"
APPROVED_STATE="${12}"

hex40='^[0-9a-f]{40}$'
hex64='^[0-9a-f]{64}$'
[[ "$EXPECTED_BASE_SHA" =~ $hex40 ]] || { echo "BLOCKED_BAD_EXPECTED_BASE" >&2; exit 20; }
[[ "$CANDIDATE_SHA" =~ $hex40 ]] || { echo "BLOCKED_BAD_CANDIDATE" >&2; exit 21; }
[[ "$WRITER_RESULT_SHA" =~ $hex64 ]] || { echo "BLOCKED_BAD_WRITER_SHA" >&2; exit 22; }
[[ "$VERIFIER_RESULT_SHA" =~ $hex64 ]] || { echo "BLOCKED_BAD_VERIFIER_SHA" >&2; exit 23; }
[[ "$EVIDENCE_SHA256" =~ $hex64 ]] || { echo "BLOCKED_BAD_EVIDENCE_SHA" >&2; exit 24; }
[ -d "$REPO/.git" ] || { echo "BLOCKED_REPO_MISSING" >&2; exit 25; }
[ -s "$ALLOWED_PATHS_FILE" ] || { echo "BLOCKED_ALLOWED_PATHS_MISSING" >&2; exit 26; }
[ -f "$WRITER_RESULT" ] && [ -f "$VERIFIER_RESULT" ] && [ -f "$EVIDENCE_PACKET" ] || { echo "BLOCKED_EVIDENCE_MISSING" >&2; exit 27; }

sha256() { shasum -a 256 "$1" | awk '{print $1}'; }
[ "$(sha256 "$WRITER_RESULT")" = "$WRITER_RESULT_SHA" ] || { echo "BLOCKED_WRITER_SHA_MISMATCH" >&2; exit 28; }
[ "$(sha256 "$VERIFIER_RESULT")" = "$VERIFIER_RESULT_SHA" ] || { echo "BLOCKED_VERIFIER_SHA_MISMATCH" >&2; exit 29; }
[ "$(sha256 "$EVIDENCE_PACKET")" = "$EVIDENCE_SHA256" ] || { echo "BLOCKED_EVIDENCE_SHA_MISMATCH" >&2; exit 30; }

python3 - "$WRITER_RESULT" "$VERIFIER_RESULT" <<'PY' || { echo "BLOCKED_RESULTS_NOT_GREEN" >&2; exit 31; }
import json,sys
writer=json.load(open(sys.argv[1],encoding='utf-8'))
verifier=json.load(open(sys.argv[2],encoding='utf-8'))
if writer.get('status') != 'PASS':
    raise SystemExit('writer status is not PASS')
summary=str(writer.get('summary') or '')
if 'VERDETTO: VERDE' not in summary:
    raise SystemExit('writer verdict is not VERDE')
if verifier.get('status') != 'PASS':
    raise SystemExit('verifier status is not PASS')
verdict=str(verifier.get('verdict') or verifier.get('summary') or '')
if 'GREEN' not in verdict and 'VERDE' not in verdict:
    raise SystemExit('fresh verifier is not GREEN')
if verifier.get('independent') is not True:
    raise SystemExit('verifier is not marked independent')
PY

git -C "$REPO" cat-file -e "$EXPECTED_BASE_SHA^{commit}" || { echo "BLOCKED_BASE_OBJECT_MISSING" >&2; exit 32; }
git -C "$REPO" cat-file -e "$CANDIDATE_SHA^{commit}" || { echo "BLOCKED_CANDIDATE_OBJECT_MISSING" >&2; exit 33; }

parents="$(git -C "$REPO" rev-list --parents -n 1 "$CANDIDATE_SHA")"
set -- ${(z)parents}
[ "$#" -eq 2 ] || { echo "BLOCKED_CANDIDATE_MERGE_OR_ROOT" >&2; exit 34; }
[ "$2" = "$EXPECTED_BASE_SHA" ] || { echo "BLOCKED_CANDIDATE_PARENT" >&2; exit 35; }
echo "CANDIDATE_EXACT_PARENT=PASS"

python3 - "$ALLOWED_PATHS_FILE" <<'PY' || { echo "BLOCKED_ALLOWED_PATHS_INVALID" >&2; exit 36; }
import sys
from pathlib import PurePosixPath
seen=set()
for raw in open(sys.argv[1],encoding='utf-8'):
    p=raw.strip()
    if not p:
        continue
    q=PurePosixPath(p)
    if q.is_absolute() or '..' in q.parts or '.git' in q.parts:
        raise SystemExit('unsafe allowed path')
    seen.add(p)
if not seen:
    raise SystemExit('empty allowed path set')
PY

git -C "$REPO" diff --name-only "$EXPECTED_BASE_SHA..$CANDIDATE_SHA" | LC_ALL=C sort -u > "$REPO/.git/fluxion-publish-changed.$$"
LC_ALL=C sort -u "$ALLOWED_PATHS_FILE" > "$REPO/.git/fluxion-publish-allowed.$$"
python3 - "$REPO/.git/fluxion-publish-changed.$$" "$REPO/.git/fluxion-publish-allowed.$$" <<'PY' || {
  rm -f "$REPO/.git/fluxion-publish-changed.$$" "$REPO/.git/fluxion-publish-allowed.$$"
  echo "BLOCKED_FORBIDDEN_PATH" >&2
  exit 37
}
import sys
changed={x.strip() for x in open(sys.argv[1],encoding='utf-8') if x.strip()}
allowed={x.strip() for x in open(sys.argv[2],encoding='utf-8') if x.strip()}
if not changed:
    raise SystemExit('empty candidate diff')
if not changed <= allowed:
    raise SystemExit('forbidden path: '+','.join(sorted(changed-allowed)))
PY
rm -f "$REPO/.git/fluxion-publish-changed.$$" "$REPO/.git/fluxion-publish-allowed.$$"
echo "ALLOWED_PATHS_ENFORCED=PASS"

# First CAS observation.
git -C "$REPO" fetch --no-tags origin 'refs/heads/master:refs/remotes/origin/master'
CURRENT_ORIGIN_MASTER="$(git -C "$REPO" rev-parse refs/remotes/origin/master)"
[ "$CURRENT_ORIGIN_MASTER" = "$EXPECTED_BASE_SHA" ] || { echo "BLOCKED_ORIGIN_MOVED" >&2; exit 38; }
echo "EXPECTED_BASE_ENFORCED=PASS"

# Second remote observation immediately before publication. This closes the
# ordinary pre-push race; a change after this point is still protected by the
# non-force fast-forward semantics of the push itself.
REMOTE_BEFORE_PUSH="$(git -C "$REPO" ls-remote --exit-code origin refs/heads/master | awk '{print $1}')"
[ "$REMOTE_BEFORE_PUSH" = "$EXPECTED_BASE_SHA" ] || { echo "BLOCKED_ORIGIN_MOVED" >&2; exit 39; }

# Intentionally no --force / --force-with-lease. A concurrent advance makes
# this normal push reject as non-fast-forward; there is no overwrite retry.
set +e
git -C "$REPO" push --porcelain origin "$CANDIDATE_SHA:refs/heads/master"
PUSH_RC=$?
set -e
[ "$PUSH_RC" -eq 0 ] || { echo "BLOCKED_NON_FAST_FORWARD_OR_PUSH_FAILURE" >&2; exit 40; }
echo "NON_FORCE_PUBLISH=PASS"

# Fetch-back is mandatory before attestation.
git -C "$REPO" fetch --no-tags origin 'refs/heads/master:refs/remotes/origin/master'
REMOTE_AFTER="$(git -C "$REPO" rev-parse refs/remotes/origin/master)"
[ "$REMOTE_AFTER" = "$CANDIDATE_SHA" ] || { echo "BLOCKED_POST_PUSH_MISMATCH" >&2; exit 41; }

dir="$(dirname "$APPROVED_STATE")"
mkdir -p "$dir"
tmp="$APPROVED_STATE.tmp.$$"
{
  printf 'APPROVED_SHA=%s\n' "$CANDIDATE_SHA"
  printf 'APPROVED_TASK=%s\n' "$TASK_ID"
  printf 'EVIDENCE_SHA256=%s\n' "$EVIDENCE_SHA256"
  printf 'WRITER_RESULT_SHA=%s\n' "$WRITER_RESULT_SHA"
  printf 'VERIFIER_RESULT_SHA=%s\n' "$VERIFIER_RESULT_SHA"
  printf 'APPROVED_AT=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} > "$tmp"
chmod 600 "$tmp"
mv "$tmp" "$APPROVED_STATE"
echo "TRUSTED_PUBLISH_GATE=PASS"
echo "APPROVED_SHA=$CANDIDATE_SHA"
